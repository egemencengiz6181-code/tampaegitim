# /admin paneli için ortam değişkenleri.
# Vercel: Project → Settings → Environment Variables bölümüne ekleyin (Production).
# Yerel geliştirme: bu dosyayı .env.local adıyla kopyalayıp doldurun.

# Panele giriş şifresi (en az 12 karakter, harf + rakam + sembol önerilir)
ADMIN_PASSWORD=

# Oturum çerezlerini imzalamak için rastgele uzun bir değer (ör. `openssl rand -hex 32`)
ADMIN_SECRET=

# GitHub fine-grained token: yalnızca bu depo, "Contents: Read and write" + "Deployments: Read" izni
# Yerelde boş bırakılırsa yazılar doğrudan content/blog klasörüne kaydedilir.
GITHUB_TOKEN=

# İsteğe bağlı (varsayılanlar):
# GITHUB_REPO=egemencengiz6181-code/tampaegitim
# GITHUB_BRANCH=main

# ---------------------------------------------------------------
# Form başvuruları → Google E-Tablo + Gmail bildirimi (docs/FORMLAR.md)
# Apps Script "Web uygulaması" adresi (https://script.google.com/macros/s/.../exec)
LEAD_WEBHOOK_URL=
# Apps Script'teki AYARLAR.GIZLI_ANAHTAR ile birebir aynı değer
LEAD_WEBHOOK_SECRET=
