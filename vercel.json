{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/universite-basvuru-rehberi",
      "destination": "/bilgi-bankasi/universite-basvuru-rehberi",
      "permanent": true
    },
    {
      "source": "/ornek-cv",
      "destination": "/kaynaklar/ornek-cv",
      "permanent": true
    },
    {
      "source": "/ornek-niyet-mektubu-2",
      "destination": "/kaynaklar/ornek-niyet-mektubu",
      "permanent": true
    },
    {
      "source": "/ornek-muvaffakatname",
      "destination": "/kaynaklar/ornek-muvaffakatname",
      "permanent": true
    },
    {
      "source": "/ornek-banka-mektubu",
      "destination": "/kaynaklar/ornek-banka-mektubu",
      "permanent": true
    },
    {
      "source": "/ornek-sponsor-mektubu",
      "destination": "/kaynaklar/ornek-sponsor-mektubu",
      "permanent": true
    },
    {
      "source": "/ornek-taahhutname",
      "destination": "/kaynaklar/ornek-taahhutname",
      "permanent": true
    },
    {
      "source": "/blog/amerika-yaz-okulu",
      "destination": "/yurtdisi-yaz-okullari/amerika",
      "permanent": true
    },
    {
      "source": "/blog/dubai-dil-okulu",
      "destination": "/yurtdisi-dil-okullari/dubai",
      "permanent": true
    },
    {
      "source": "/blog/malta-dil-okulu-rehberi",
      "destination": "/yurtdisi-dil-okullari/malta",
      "permanent": true
    },
    {
      "source": "/blog/brighton-dil-okulu",
      "destination": "/yurtdisi-dil-okullari/ingiltere/brighton-dil-okullari",
      "permanent": true
    },
    {
      "source": "/blog/polonyada-universite-okumak",
      "destination": "/lisans-programlari/polonya",
      "permanent": true
    },
    {
      "source": "/blog/almanyada-ucretsiz-universite",
      "destination": "/lisans-programlari/almanya",
      "permanent": true
    },
    {
      "source": "/blog/ingilterede-lise-egitimi",
      "destination": "/yurtdisi-lise-egitimi/ingiltere",
      "permanent": true
    },
    {
      "source": "/blog/irlanda-work-and-study-rehberi",
      "destination": "/work-and-study/irlanda",
      "permanent": true
    },
    {
      "source": "/blog/kanada-dil-okulu-ve-co-op",
      "destination": "/work-and-study/kanada",
      "permanent": true
    },
    {
      "source": "/blog/ingiltere-yaz-kamplari-ve-gencler-icin-firsatlar",
      "destination": "/blog/ingiltere-yaz-okulu-rehberi",
      "permanent": true
    },
    {
      "source": "/blog/cocuklar-icin-ingiltere-yaz-kampi",
      "destination": "/blog/ingiltere-yaz-okulu-rehberi",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "content/blog-config.json"
    }
  }
}
