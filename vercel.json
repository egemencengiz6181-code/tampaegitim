{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/universite-basvuru-rehberi",
      "destination": "/bilgi-bankasi/universite-basvuru-rehberi",
      "permanent": true
    },
    {
      "source": "/ornek-cv",
      "destination": "/kaynaklar/ornek-cv",
      "permanent": true
    },
    {
      "source": "/ornek-niyet-mektubu-2",
      "destination": "/kaynaklar/ornek-niyet-mektubu",
      "permanent": true
    },
    {
      "source": "/ornek-muvaffakatname",
      "destination": "/kaynaklar/ornek-muvaffakatname",
      "permanent": true
    },
    {
      "source": "/ornek-banka-mektubu",
      "destination": "/kaynaklar/ornek-banka-mektubu",
      "permanent": true
    },
    {
      "source": "/ornek-sponsor-mektubu",
      "destination": "/kaynaklar/ornek-sponsor-mektubu",
      "permanent": true
    },
    {
      "source": "/ornek-taahhutname",
      "destination": "/kaynaklar/ornek-taahhutname",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "content/blog-config.json"
    }
  }
}
